{
  "name": "furryup-live-connect",
  "version": "0.8.0",
  "private": true,
  "description": "四平台直播事件、五平台主页和粉丝数，以及四平台创作者收益适配与月度账本",
  "license": "MIT",
  "author": "FrostyNight",
  "main": "core/index.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/frostynight-furry/furryup-live-connect.git"
  },
  "homepage": "https://github.com/frostynight-furry/furryup-live-connect#readme",
  "bugs": {
    "url": "https://github.com/frostynight-furry/furryup-live-connect/issues"
  },
  "keywords": [
    "furryup",
    "livestream",
    "danmaku",
    "bilibili",
    "douyin",
    "kuaishou",
    "wechat",
    "xiaohongshu",
    "followers",
    "profile"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build-java.cjs",
    "test": "node scripts/test.cjs",
    "test:wechat": "node --test test/wechat.test.cjs",
    "test:core": "node --test test/core*.cjs",
    "test:examples": "node --test test/examples.test.cjs",
    "test:java": "node scripts/test-java.cjs",
    "start:java": "node examples/java-stdin.cjs",
    "start:java:subscribe": "node examples/java-subscribe.cjs",
    "start:wechat": "electron examples/wechat-electron.cjs",
    "start:subscribe": "node examples/subscribe.cjs",
    "start:multi": "node examples/multi-platform.cjs",
    "demo": "node examples/offline-demo.cjs",
    "audit": "node scripts/audit-source.cjs",
    "test:profiles": "node --test test/profiles*.cjs",
    "demo:profiles": "node examples/profile-demo.cjs",
    "test:events": "node --test test/event-contract.test.cjs test/event-replay.test.cjs test/source-audit.test.cjs",
    "replay": "node examples/replay-events.cjs",
    "test:creator:electron": "electron scripts/test-creator-electron.cjs",
    "start:creator": "electron examples/creator-followers-electron.cjs",
    "test:revenue": "node --test test/revenue*.test.cjs",
    "test:revenue:electron": "electron scripts/test-revenue-electron.cjs && electron scripts/test-revenue-extra-electron.cjs",
    "demo:revenue": "node examples/revenue-demo.cjs",
    "start:revenue": "electron examples/creator-revenue-electron.cjs",
    "start:revenue:wallet": "electron examples/douyin-wallet-sync-electron.cjs",
    "start:revenue:sync": "electron examples/creator-revenue-sync-electron.cjs",
    "start:revenue:android": "node examples/douyin-wallet-android.cjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "electron": "43.8.3"
  }
}
